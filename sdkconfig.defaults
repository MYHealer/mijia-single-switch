# ESP32-C3 SuperMini 压测灯 - 压力传感器按一下 -> 米家开灯
# ESP-IDF 5.5.4 目标配置
CONFIG_IDF_TARGET="esp32c3"

# --- 4MB Flash，自定义分区 ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Coredump：崩溃现场存 flash，供 idf.py coredump-info 解析 ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# --- WiFi STA ---
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y

# --- LWIP：只留 IPv4 + DNS 即可，省内存 ---
CONFIG_LWIP_IPV6=n

# --- mbedTLS：需要 SHA1（RC4 签名）+ SHA256（session key）---
# api.mijia.tech 是公网真实 HTTPS，证书 bundle 必须开，否则 TLS 握手必败
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_SHA1_C=y
CONFIG_MBEDTLS_SHA256_C=y
# 注：RC4 由驱动手写（mbedTLS 5.x 已移除 RC4 cipher），无需配置

# --- NimBLE（米家无线开关广播；WiFi 直连已停用，内存让给 BT）---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_SVC_GAP=y
CONFIG_BT_NIMBLE_SVC_GATT=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# --- ESP HTTP Client：HTTPS 用于 api.mijia.tech ---
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# --- 主任务栈加大：MIoT 请求 + 解析占栈 ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- C3 无 PSRAM，全部内部 RAM ---
# CONFIG_SPIRAM is not set

# --- 编译输出更小、默认 ---
# CONFIG_COMPILER_OPTIMIZATION_PERF is not set